source "https://rubygems.org"

# Unversioned on purpose, and no Gemfile.lock. GitHub Pages' legacy build ignores this file and
# builds with the github-pages gem's own exact versions; the file serves a local preview, and
# taking the latest github-pages keeps that preview on what Pages runs now.
gem "github-pages", group: :jekyll_plugins
# github-pages pins this exactly; a version here would be a second pin of the same gem.
gem "jekyll-remote-theme"
